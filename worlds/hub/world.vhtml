<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Hub. Your room part way up the giant tower at the centre of a dense, colourful town,
  packed inside one immense circular wall. Streets squeeze off from the plaza below your
  balcony between blocks of tall houses. Empty for now. First laid out by
  tools/sample-assets/make-hub.mjs, now edited by hand. Sections: ground, streets, domes,
  houses, bunting, wall, plaza, tower, room, balcony.
  VHTML 0.1: meters, +Y up, rotations in degrees. "v-" is a placeholder prefix (#25, #11).
-->
<v-world vhtml="0.1" title="The Hub" spawn="0 20 -11.2" sky="#86bdf0">

  <v-group id="ground">
    <!-- The ground: paved streets, and courtyards inside the blocks -->
    <v-cylinder radius="248" height="0.2" position="0 0.1 0" color="#cdbf9f" segments="64" collide="true" surface="paving"/>

